{
  "name": "@gustavohps10/claude-theme",
  "version": "0.2.1",
  "private": true,
  "description": "Claude theme for Mr. Tick, with light and dark palettes.",
  "author": "Gustavo Henrique",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "https://github.com/Gustavohps10/claude-theme.git"
  },
  "files": [
    "dist",
    "icon.png"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:unit": "vitest run",
    "validate": "mr-tick validate ./",
    "sync:manifest": "mr-tick sync ./",
    "pkg": "mr-tick pkg ./",
    "changeset": "changeset"
  },
  "dependencies": {
    "@mr-tick/sdk": "0.13.0"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.6",
    "@eslint/js": "^9.25.1",
    "@types/node": "^22.15.0",
    "eslint": "^9.25.1",
    "globals": "^16.0.0",
    "tsup": "^8.5.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.30.1",
    "vitest": "^3.0.0"
  },
  "packageManager": "yarn@4.9.4"
}
